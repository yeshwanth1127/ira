## Server runtime
PORT=5000

## Database
DATABASE_URL=postgres://user:password@host:5432/ira

## Auth
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
## Must match admin-api `ADMIN_SECRET` exactly (admin-api default if unset: ghost-admin-jwt-secret-2025)
CUSTOMER_JWT_SECRET=ghost-admin-jwt-secret-2025
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

## Licensing
LICENSE_KEY_SECRET=change_me_to_a_long_random_string
LICENSE_MAX_ACTIVATIONS_DEFAULT=1

## Billing (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

## Internal (optional) - used for /licenses/generate
INTERNAL_API_KEY=change_me_if_you_use_internal_endpoints

## LLM (existing)
OPENROUTER_API_KEY=sk-or-v1-...

