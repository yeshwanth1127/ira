## Server runtime
PORT=5000

## Database
DATABASE_URL=postgres://user:password@host:5432/ira

## Auth
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
## Must match admin-api `ADMIN_SECRET` (same string). Admin-api default if unset: ira-admin-jwt-secret-2025
## You may set CUSTOMER_JWT_SECRET here or reuse the same value as ADMIN_SECRET.
CUSTOMER_JWT_SECRET=ira-admin-jwt-secret-2025
# ADMIN_SECRET=ira-admin-jwt-secret-2025
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

## Licensing
LICENSE_KEY_SECRET=change_me_to_a_long_random_string
LICENSE_MAX_ACTIVATIONS_DEFAULT=1

## Billing (Razorpay)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

## Internal — must match admin-api INTERNAL_API_KEY (used for POST /licenses/internal/issue, /licenses/generate)
INTERNAL_API_KEY=change_me_if_you_use_internal_endpoints

## Verbose logs for internal key failures + startup key length (no secret printed)
# DEBUG_IRA_INTERNAL=1

## LLM (existing)
OPENROUTER_API_KEY=sk-or-v1-...

