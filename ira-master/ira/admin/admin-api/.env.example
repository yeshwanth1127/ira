# Same database as IRA backend / scribe-api (required)
DATABASE_URL=postgresql://user:pass@localhost:5432/ira

# Optional: copy from scribe-api/.env or set here
# Admin credentials are in admin_users table (default: admin / ghostadmin123 — change in DB)

# JWT secret (optional, has default)
# ADMIN_SECRET=your-admin-jwt-secret

# IRA Node backend — license keys are minted here only (must match backend INTERNAL_API_KEY)
# IRA_BACKEND_URL=http://127.0.0.1:5000
# INTERNAL_API_KEY=shared-secret-with-ira-backend

# Port (default 6660)
# ADMIN_PORT=6660

# Razorpay (for subscriptions)
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
# RAZORPAY_PLAN_STARTER=plan_xxx
# RAZORPAY_PLAN_PRO=plan_xxx
# RAZORPAY_PLAN_POWER=plan_xxx

# Email for OTP - use one of:
# 1. Resend API (free 100/day, verify domain at resend.com): RESEND_API_KEY=re_xxx
# 2. SMTP (Hostinger, etc.): SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD
# 3. Dev mode (log OTP to server, no email): OTP_LOG_DEV=1
RESEND_API_KEY=
SMTP_FROM_EMAIL=support@exora.solutions

# When OTP_LOG_DEV=1: OTP is logged to pm2 logs instead of sending email (for testing)
# OTP_LOG_DEV=1
